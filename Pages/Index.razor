@page "/"
@inject NavigationManager Navigation

<h1 class="page-title">Добро пожаловать в Свинтус 🐷</h1>

<div class="form-container">
    <input class="input" placeholder="Введите код комнаты" @bind="RoomCode" />

    <button @onclick="JoinRoom" class="btn btn-start">
        Присоединиться
    </button>

    <p class="hint">Или используйте любой код, чтобы создать новую комнату</p>
</div>

@code {
    private string RoomCode = "";

    private void JoinRoom()
    {
        if (!string.IsNullOrWhiteSpace(RoomCode))
        {
            Navigation.NavigateTo($"/game/{RoomCode.Trim()}");
        }
    }
}
